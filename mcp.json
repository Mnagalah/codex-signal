{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "menu_status": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${PLUGIN_ROOT}/scripts/launch.sh"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
